# Copy to cluster.env and customize. cluster.env is gitignored.
PARTITION=gpu
CPU_PARTITION=cpu
ACCOUNT=your_account
EMAIL=you@example.org
PROJECT_ROOT=/path/to/echosynth
PYTHON=/path/to/conda/envs/echosynth/bin/python
DIFFUSION_CONFIG=configs/diffusion/duke_ca.yaml
EXPERIMENT_CONFIG=configs/experiment/duke_two_step_allview.yaml
TRAIN_MANIFEST=manifests/duke_train.csv
SYNTHETIC_MANIFEST=manifests/synthetic_duke_ca.csv
SAMPLE_COUNTS='{CA: 100}'
DICOM_SHARD_ROOT=/path/to/dicom/shards
PREPROCESS_OUTPUT=/path/to/preprocessed
